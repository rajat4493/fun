{
  "name": "fun-one-pick-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "sh scripts/with-node.sh next dev . --webpack -H 127.0.0.1",
    "build": "sh scripts/with-node.sh ./node_modules/.bin/next build . --webpack",
    "start": "sh scripts/with-node.sh next start",
    "lint": "sh scripts/with-node.sh tsc -p tsconfig.lint.json --noEmit --pretty false",
    "test:availability": "sh scripts/with-node.sh node scripts/check-availability.mjs",
    "test:recommendation": "sh scripts/with-node.sh node scripts/recommendation-regression.mjs",
    "test:gate": "sh scripts/with-node.sh node scripts/qa-gate.mjs",
    "test:launch": "sh scripts/with-node.sh node --test scripts/launch-regression.test.mjs",
    "latency:report": "sh scripts/with-node.sh node scripts/latency-report.mjs",
    "diagnostics:summary": "sh scripts/with-node.sh node --env-file=.env.local scripts/diagnostics-summary.mjs"
  },
  "dependencies": {
    "lucide-react": "0.562.0",
    "next": "16.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.13",
    "typescript": "5.8.3"
  }
}
